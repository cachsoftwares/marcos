<div class="columns">

    <div class="column is-10-mobile is-offset-1-mobile is-6-tablet is-offset-3-tablet is-4-desktop is-offset-4-desktop">

        <h1 class="is-size-1 has-text-centered upper-text mb-5">Atualizar Dados</h1>

        <form action="/user/edit" method="post">
            <input name="id" id="id" class="input" type="hidden" value="{{user._id}}">
            <div class="field">
                <label class="label">Nome</label>
                <div class="control">
                    <input name="nome" id="nome" class="input" type="text" value="{{user.nome}}">
                </div>
            </div>

            <div class="field">
                <label class="label">Telefone</label>
                <div class="control">
                    <input name="ident" id="ident" class="input" type="number" value="{{user.ident}}">
                </div>
            </div>

            <div class="field">
                <label class="label">Senha</label>
                <div class="control">
                    <input name="senha" id="senha" class="input" type="password">
                </div>
            </div>

            <div class="field">
                <label class="label">Confirme a Senha</label>
                <div class="control">
                    <input name="conf_senha" id="conf_senha" class="input" type="password">
                </div>
            </div>

            <div>
                <p>
                    <label>
                        <input type="checkbox" onclick="ver_senha()" />
                        <span>Ver Senha</span>
                    </label>
                </p>
            </div>

            <div class="columns mt-3">
                <div class="column is-6-mobile is-offset-3-mobile is-4-tablet is-offset-4-tablet">
                    <button type="submit" class="button is-success has-text-light w-100">Atualizar</button>
                </div>
            </div>
        </form>
    </div>
</div>


<div class="columns unselected">
    <div class="column is-10-mobile is-6-tablet is-4-desktop is-offset-1-mobile is-offset-3-tablet is-offset-4-desktop">
        {{#each erros}}
        <div class="error_msg box py-3 has-background-danger has-text-white has-text-centered">
            <p class="flash-msg">
                {{texto}}
            </p>
        </div>
        {{else}}

        {{/each}}
    </div>
</div>